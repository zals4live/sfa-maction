# Web Portal (Nuxt 4) environment variables.
# Copy to `.env` for local development. Never commit `.env` (see .gitignore).

# Public base URL the browser uses to reach the API.
# In dev, leave as the same-origin `/api` prefix so the nitro devProxy forwards to the
# Elysia backend. In production, Nginx terminates SSL and routes `/api` upstream.
NUXT_PUBLIC_API_BASE=/api

# Upstream Elysia backend URL for the dev proxy (nitro devProxy target).
# Only used in local development; production routing is handled by Nginx.
API_BASE_URL=http://localhost:3000
